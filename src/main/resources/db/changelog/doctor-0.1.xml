<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="doctor-0.1" author="aidana">
        <createTable tableName="doctors">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="middle_name" type="VARCHAR(100)"/>
            <column name="birth_date" type="DATE"/>
            <column name="phone" type="VARCHAR(30)">
                <constraints unique="true"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints unique="true"/>
            </column>
            <column name="keycloak_id" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>
            <column name="specialty_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="doctors" baseColumnNames="specialty_id"
                                 referencedTableName="specialties"
                                 referencedColumnNames="id" constraintName="fk_doctors_specialties"/>
    </changeSet>

</databaseChangeLog>