<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-lab-appointments" author="aidana">

        <createTable tableName="lab_appointments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="patients"
                             referencedColumnNames="id" foreignKeyName="fk_lab_appointments_patient"/>
            </column>
            <column name="lab_slot_id" type="BIGINT">
                <constraints nullable="false" referencedTableName="lab_slots"
                             referencedColumnNames="id" foreignKeyName="fk_lab_appointments_slot"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

    </changeSet>

</databaseChangeLog>